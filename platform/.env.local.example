# Copier ce fichier en ".env.local" (jamais commité) et renseigner les valeurs
# du projet Supabase (voir README.md pour la procédure de création).

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Project Settings > API > Project API keys > anon public
# Clé publique : son usage reste sans danger car toute la sécurité est portée
# par les policies RLS (Row Level Security) de la base, jamais par cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Messagerie interne uniquement ---
# Project Settings > API > Project API keys > service_role — SECRET, ne jamais
# exposer au navigateur ni commiter : contourne RLS, utilisé par la purge de
# rétention nocturne (src/app/api/cron/messagerie/route.ts) ET par l'envoi
# des alertes e-mail à chaque message (lib/messagerie/alertes.ts), la seule
# façon de lire l'adresse e-mail d'un destinataire (auth.admin.getUserById).
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret partagé avec Vercel Cron (cf. vercel.json) pour protéger la route de
# purge ci-dessus ; à définir aussi dans Project Settings > Environment Variables.
CRON_SECRET=choisir-une-valeur-aleatoire-longue

# Optionnel : sans ces deux variables, les messages continuent de fonctionner
# mais aucun courriel d'alerte n'est envoyé (cf. README).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optionnel : URL publique du site, utilisée pour composer le lien "Ouvrir le
# message" dans les alertes e-mail (ex. https://ged-khs-bank.vercel.app).
# Sans elle, le lien est relatif et ne fonctionne pas depuis une boîte mail.
NEXT_PUBLIC_SITE_URL=

# Optionnel : active la seconde couche d'analyse antivirus des pièces
# jointes (cloudmersive.com, offre gratuite : 800 analyses/mois). Sans cette
# clé, seuls les contrôles intégrés s'appliquent (cf. README).
CLOUDMERSIVE_API_KEY=

# --- Personnalisation de la marque (src/lib/organisation.ts) ---
# Optionnel : permet de redéployer EXACTEMENT le même code pour une autre
# organisation (nouveau projet Supabase + nouveau projet Vercel), sans rien
# changer au code. Sans ces variables, l'interface affiche "KHS Bank" comme
# aujourd'hui — un déploiement existant n'a donc rien à changer.
NEXT_PUBLIC_ORG_NOM=
# Nom affiché sur la version anglaise du site public (sinon, le nom ci-dessus)
NEXT_PUBLIC_ORG_NOM_EN=
NEXT_PUBLIC_ORG_SIGLE=
NEXT_PUBLIC_ORG_LOGO_LETTRE=
NEXT_PUBLIC_ORG_MENTION_CONNEXION=

# Chemin (sous public/) d'un vrai logo image, prioritaire sur la lettre
# ci-dessus. Exemple : /logos/logo-agence-investissement-cameroun.png
NEXT_PUBLIC_ORG_LOGO_URL=

# Deux couleurs d'ancrage (hex) : src/lib/couleurs.ts en dérive toute la
# gamme "navy" (fonds sombres) et "gold" (accents) par calcul. Sans elles,
# les couleurs KHS Bank actuelles restent inchangées.
NEXT_PUBLIC_ORG_COULEUR_PRIMAIRE=
NEXT_PUBLIC_ORG_COULEUR_ACCENT=

# Liseré tricolore optionnel sous le logo (2 à 4 couleurs hex séparées par
# des virgules, ex. "#008d36,#e30613,#f8bc3a"). Vide = pas de liseré.
NEXT_PUBLIC_ORG_COULEUR_RUBAN=

# Optionnel : à "true" pour activer le site public institutionnel (page
# d'accueil, missions, services, actualités) à la place de la redirection
# directe vers /documents. Sans elle (ou à toute autre valeur), / redirige
# vers /documents comme aujourd'hui — déploiement KHS Bank inchangé.
NEXT_PUBLIC_ORG_SITE_PUBLIC=
